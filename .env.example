APP_NAME=Ylmz
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# MySQL / MariaDB
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demo
DB_USER=root
DB_PASS=

# Redis (optional - for cache & queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=ylmz:

# Cache driver: file | redis
CACHE_DRIVER=file

# Queue driver: redis
QUEUE_DRIVER=redis

# Session driver: file
SESSION_DRIVER=file

# Log driver: file | db
LOG_DRIVER=file

# Paths (relative to project root)
CACHE_PATH=runtime/cache
LOG_PATH=runtime/log
TWIG_CACHE=runtime/twig
